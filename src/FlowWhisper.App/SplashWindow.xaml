<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FlowWhisper_App.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!-- Startup confirmation in the same glass style as the FlowBar (see FlowBarWindow.xaml
         for what each layer does). Never activated, so it can't steal focus at login. -->

    <Grid>
        <Grid x:Name="TintLayers" IsHitTestVisible="False">
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
                        <GradientStop Offset="0" Color="#59D6E4FA" />
                        <GradientStop Offset="0.55" Color="#73B4C8EE" />
                        <GradientStop Offset="1" Color="#99A9B4E6" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#B3FFFFFF" />
                        <GradientStop Offset="0.35" Color="#26FFFFFF" />
                        <GradientStop Offset="0.37" Color="#00FFFFFF" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
        <!-- Minimal edge: one faint hairline instead of the FlowBar's rim (Windows' own
             window border is turned off in code-behind). -->
        <Border IsHitTestVisible="False" BorderThickness="1" CornerRadius="8" BorderBrush="#40FFFFFF" />

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Padding="24,0">
            <Image x:Name="AppIconImage" Width="56" Height="56" HorizontalAlignment="Center" />
            <TextBlock Text="FlowWhisper" HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold" />
            <TextBlock
                x:Name="StatusText"
                HorizontalAlignment="Center"
                FontSize="13"
                Opacity="0.8"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <ProgressBar x:Name="LoadingBar" Width="180" IsIndeterminate="True" />
        </StackPanel>
    </Grid>
</Window>
