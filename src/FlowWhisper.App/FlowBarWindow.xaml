<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FlowWhisper_App.FlowBarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FlowWhisper_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!-- The glass itself is GlassBackdrop, set in code-behind: the built-in
         DesktopAcrylicBackdrop falls back to a flat color in inactive windows, and this
         window is never activated (it must not take focus from the app being dictated into). -->

    <Grid x:Name="Root">
        <!-- Tinted body: a cool blue-lavender wash, deeper towards the bottom, so the glass
             reads as a distinct object even over white apps (where acrylic alone looks white). -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
                    <GradientStop Offset="0" Color="#59D6E4FA" />
                    <GradientStop Offset="0.55" Color="#73B4C8EE" />
                    <GradientStop Offset="1" Color="#99A9B4E6" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Depth: a soft inner shadow along the bottom, as under a curved surface. -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0.6" Color="#00203060" />
                    <GradientStop Offset="1" Color="#2E203060" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Specular sheen across the top half, like light catching curved glass. -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#E6FFFFFF" />
                    <GradientStop Offset="0.38" Color="#33FFFFFF" />
                    <GradientStop Offset="0.40" Color="#00FFFFFF" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Highlight streak: a thin bright line just under the top edge. -->
        <Rectangle
            Height="1.5"
            Margin="14,3,14,0"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            RadiusX="1"
            RadiusY="1">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#00FFFFFF" />
                    <GradientStop Offset="0.3" Color="#FFFFFFFF" />
                    <GradientStop Offset="0.7" Color="#FFFFFFFF" />
                    <GradientStop Offset="1" Color="#00FFFFFF" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Outer hairline: separates the glass from light backgrounds. -->
        <Border IsHitTestVisible="False" BorderThickness="1" CornerRadius="8" BorderBrush="#4D2A3A5A" />

        <!-- Iridescent rim just inside it, like light refracting at the glass edge. -->
        <Border IsHitTestVisible="False" Margin="1" BorderThickness="1.5" CornerRadius="7">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#FFFFFFFF" />
                    <GradientStop Offset="0.35" Color="#CCB8E2FF" />
                    <GradientStop Offset="0.65" Color="#B3D9C2FF" />
                    <GradientStop Offset="1" Color="#E6FFFFFF" />
                </LinearGradientBrush>
            </Border.BorderBrush>
        </Border>

        <Grid Padding="20,12" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Recording dot with a soft glow. -->
            <Grid Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center">
                <Ellipse Fill="#40FF4D4D" Width="12" Height="12" />
                <Ellipse x:Name="StatusDot" Fill="#FFFF4D4D" Width="7" Height="7" />
            </Grid>
            <TextBlock
                x:Name="StatusText"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="13"
                FontWeight="SemiBold"
                Opacity="0.75" />
            <!-- Rolling waveform: bars are created in code-behind. -->
            <Canvas
                x:Name="WaveformCanvas"
                Grid.Column="2"
                Width="220"
                Height="30"
                VerticalAlignment="Center" />

            <TextBlock
                x:Name="TranscriptText"
                Grid.Row="1"
                Grid.ColumnSpan="3"
                FontSize="15"
                MaxLines="2"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>
